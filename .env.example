# ---------------------------------------------------------------- database --
# Neon / Vercel Postgres connection string (use the POOLED url on Vercel).
# Local example: postgres://postgres:zephiel@localhost:55432/zephiel
DATABASE_URL=

# ------------------------------------------------------------ seed admin ---
# Used only by `npm run db:seed` to create the first administrator.
ADMIN_EMAIL=admin@zephiel.dev
ADMIN_PASSWORD=zephiel-admin

# ------------------------------------------------------------- paystack ----
# From dashboard.paystack.com/#/settings/developer (test keys start sk_test_).
# Checkout is redirect-based, so only the secret key is needed.
PAYSTACK_SECRET_KEY=

# Currency your Paystack account settles in: NGN, GHS, ZAR, KES, or USD.
PAYSTACK_CURRENCY=NGN
# Catalog prices are stored in USD; this converts them when charging in NGN.
USD_TO_NGN=1550

# ----------------------------------------------------------------- app -----
# Absolute origin, used for Paystack callbacks, canonical URLs, and the sitemap.
# No trailing slash. Optional on Vercel, which supplies its own domain.
APP_URL=http://localhost:3000
