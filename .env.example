# ---------------------------------------------------------------- database --
# Neon / Vercel Postgres connection string (use the POOLED url on Vercel).
# Local example: postgres://postgres:zephiel@localhost:55432/zephiel
DATABASE_URL=

# ------------------------------------------------------------ seed admin ---
# Used only by `npm run db:seed` to create the first administrator.
ADMIN_EMAIL=admin@zephiel.dev
ADMIN_PASSWORD=zephiel-admin

# ------------------------------------------------------------- paystack ----
# From dashboard.paystack.com/#/settings/developer (test keys start sk_test_).
# Optional: the key can also be set in the admin console at /admin/settings,
# which takes precedence over this value.
PAYSTACK_SECRET_KEY=

# Encrypts secrets saved from the admin console. Any long random string.
# Without it, the encryption key is derived from DATABASE_URL instead.
SETTINGS_KEY=

# Currency your Paystack account settles in: NGN, GHS, ZAR, KES, or USD.
PAYSTACK_CURRENCY=NGN
# Catalog prices are stored in USD; this converts them when charging in NGN.
USD_TO_NGN=1550

# ----------------------------------------------------------------- app -----
# Absolute origin, used for Paystack callbacks, canonical URLs, and the sitemap.
# No trailing slash. Optional on Vercel, which supplies its own domain.
APP_URL=http://localhost:3000

# ------------------------------------------------------------- email ------
# Resend API key for renewal reminders. Can also be set in the admin console
# at /admin/settings, which takes precedence.
RESEND_API_KEY=
EMAIL_FROM=Zephiel API <onboarding@resend.dev>

# Shared secret Vercel Cron sends as a Bearer token. Without it the reminder
# endpoint refuses to run rather than defaulting to open.
CRON_SECRET=
